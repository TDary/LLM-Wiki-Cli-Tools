#!/bin/bash
# wiki-bootstrap — 一键安装配置知识库自动同步仓库
# 适用平台：Hermes Agent / Claude Code / OpenClaw / 任何能调 shell 的 agent
#
# 用法：
#   wiki-bootstrap <REMOTE_URL> [LOCAL_PATH] [OPTIONS]
#   wiki-bootstrap git@gitlab.com:team/wiki.git ~/team-wiki
#   wiki-bootstrap https://github.com/user/wiki.git
#
# 选项：
#   --name NAME         项目名（默认取路径 basename）
#   --domain DOMAIN     领域描述（默认 "LLM Wiki 知识库"）
#   --sync-interval N   自动同步间隔（分钟，默认 10，设为 0 则不注册 cron）
#   --committer NAME    提交者名字（默认 "AI Assistant"）
#   --committer-email E 提交者邮箱（默认 "ai@local"）
#   --no-cron           不注册定时同步任务
#   --no-clone          跳过 clone，直接对已有目录执行 init + 配置
#   --force             覆盖已存在的 SCHEMA.md / README.md
#   --token TOKEN       Git 访问令牌（写入 ~/.git-credentials，自动配置 store）
#
# 退出码：
#   0 — 成功
#   1 — 参数错误
#   2 — clone 失败
#   3 — 初始化失败
#   4 — cron 注册失败

set -euo pipefail

# ============================================================
# 默认值
# ============================================================
DEFAULT_DOMAIN="LLM Wiki 知识库"
DEFAULT_SYNC_INTERVAL=10
DEFAULT_COMMITTER="AI Assistant"
DEFAULT_COMMITTER_EMAIL="ai@local"

SYNC_INTERVAL="$DEFAULT_SYNC_INTERVAL"
COMMITTER_NAME="$DEFAULT_COMMITTER"
COMMITTER_EMAIL="$DEFAULT_COMMITTER_EMAIL"
DOMAIN="$DEFAULT_DOMAIN"
NO_CRON=false
NO_CLONE=false
FORCE=false
WIKI_NAME=""
TOKEN=""

# ============================================================
# 帮助
# ============================================================
usage() {
    cat <<'EOF'
wiki-bootstrap — 一键安装配置知识库自动同步仓库

用法:
  wiki-bootstrap <REMOTE_URL> [LOCAL_PATH] [OPTIONS]

示例:
  wiki-bootstrap git@gitlab.com:group/wiki.git ~/team-wiki
  wiki-bootstrap https://github.com/user/wiki.git --name my-wiki
  wiki-bootstrap <url> ~/existing-dir --no-clone --force

选项:
  --name NAME           项目名（默认取路径 basename）
  --domain DOMAIN       领域描述
  --sync-interval N     自动同步间隔（分钟，默认 10，0 = 不注册 cron）
  --committer NAME      提交者名字
  --committer-email E   提交者邮箱
  --no-cron             不注册定时同步任务
  --no-clone            跳过 clone，直接对已有目录执行配置
  --force               覆盖已存在的 SCHEMA.md
  --token TOKEN         Git 访问令牌（自动写入 ~/.git-credentials）

输出:
  执行完成后打印配置摘要，包含 cron 任务 ID
EOF
    exit 1
}

# ============================================================
# 参数解析
# ============================================================
[ $# -ge 1 ] || usage

# 先处理 --help，避免被当作 REMOTE_URL
for arg in "$@"; do
    case "$arg" in
        -h|--help) usage ;;
    esac
done

REMOTE_URL="$1"
shift

LOCAL_PATH=""
while [ $# -gt 0 ]; do
    case "$1" in
        --name)            WIKI_NAME="$2"; shift ;;
        --domain)          DOMAIN="$2"; shift ;;
        --sync-interval)   SYNC_INTERVAL="$2"; shift ;;
        --committer)       COMMITTER_NAME="$2"; shift ;;
        --committer-email) COMMITTER_EMAIL="$2"; shift ;;
        --no-cron)         NO_CRON=true ;;
        --no-clone)        NO_CLONE=true ;;
        --force)           FORCE=true ;;
        --token)           TOKEN="$2"; shift ;;
        -h|--help)         usage ;;
        -*)
            echo "❌ 未知选项: $1"
            usage
            ;;
        *)
            LOCAL_PATH="$1"
            ;;
    esac
    shift
done

# 默认路径：取远程仓库名
REPO_BASENAME="$(basename -- "$REMOTE_URL" .git)"
LOCAL_PATH="${LOCAL_PATH:-$HOME/$REPO_BASENAME}"
LOCAL_PATH="$(eval echo "$LOCAL_PATH")"  # 展开 ~

WIKI_NAME="${WIKI_NAME:-$(basename -- "$LOCAL_PATH")}"

# ============================================================
# 标题
# ============================================================
echo ""
echo "╔════════════════════════════════════════════════════════╗"
echo "║          wiki-bootstrap · 一键安装知识库               ║"
echo "╚════════════════════════════════════════════════════════╝"
echo ""
echo "  项目名:     $WIKI_NAME"
echo "  领域:       $DOMAIN"
echo "  本地路径:   $LOCAL_PATH"
echo "  远程仓库:   $REMOTE_URL"
echo "  自动同步:   $SYNC_INTERVAL 分钟/次"
echo "  提交者:     $COMMITTER_NAME <$COMMITTER_EMAIL>"
if [ -n "$TOKEN" ]; then
    echo "  Token:      [已提供，将自动写入 ~/.git-credentials]"
fi
echo ""

# ============================================================
# Step 1: Clone or verify
# ============================================================
if [ "$NO_CLONE" = false ]; then
    if [ -d "$LOCAL_PATH/.git" ]; then
        echo "📦 Step 1: 检测到已有 Git 仓库，跳过 clone"
        cd "$LOCAL_PATH"
        git fetch origin 2>/dev/null || echo "   ⚠️  无法 fetch 远程仓库（可能离线）"
    elif [ -d "$LOCAL_PATH" ]; then
        echo "📦 Step 1: 目录已存在但非 Git 仓库"
        cd "$LOCAL_PATH"
        if [ -n "$(ls -A "$LOCAL_PATH" 2>/dev/null)" ]; then
            echo "   ⚠️  目录非空，将保留已有内容继续初始化"
        fi
    else
        echo "📦 Step 1: git clone $REMOTE_URL → $LOCAL_PATH"
        if git clone "$REMOTE_URL" "$LOCAL_PATH" 2>/dev/null; then
            echo "   ✅ clone 成功"
        else
            echo "   ⚠️  clone 失败，将初始化本地仓库（可稍后手动关联远程）"
            mkdir -p "$LOCAL_PATH"
            cd "$LOCAL_PATH"
            git init
            git remote add origin "$REMOTE_URL" 2>/dev/null || true
        fi
    fi
else
    echo "📦 Step 1: --no-clone 模式，跳过 clone"
    if [ ! -d "$LOCAL_PATH" ]; then
        echo "❌ 路径不存在: $LOCAL_PATH"
        exit 2
    fi
fi

# ============================================================
# Step 2: wiki-init
# ============================================================
echo ""
echo "📂 Step 2: 初始化 wiki 结构"

FORCE_FLAG=""
[ "$FORCE" = true ] && FORCE_FLAG="--force"

wiki-init "$LOCAL_PATH" "$DOMAIN" --name "$WIKI_NAME" --no-git $FORCE_FLAG || {
    echo "❌ wiki-init 失败"
    exit 3
}

# ============================================================
# Step 3: Git 配置
# ============================================================
echo ""
echo "🔧 Step 3: Git 配置"

cd "$LOCAL_PATH"

# 确保有 .git
if [ ! -d .git ]; then
    git init
    echo "   📌 git init"
fi

# 配置远程（如果还没有）
if ! git remote get-url origin &>/dev/null; then
    git remote add origin "$REMOTE_URL"
    echo "   📌 git remote add origin"
else
    CURRENT_REMOTE="$(git remote get-url origin)"
    if [ "$CURRENT_REMOTE" != "$REMOTE_URL" ]; then
        git remote set-url origin "$REMOTE_URL"
        echo "   📌 git remote set-url origin"
    fi
fi

# 配置提交身份
git config user.name "$COMMITTER_NAME"
git config user.email "$COMMITTER_EMAIL"
echo "   👤 $COMMITTER_NAME <$COMMITTER_EMAIL>"

# 配置 credential store
if [ -n "$TOKEN" ]; then
    # 从 REMOTE_URL 提取主机名
    if [[ "$REMOTE_URL" =~ ^https?://([^/@:]+) ]]; then
        CRED_HOST="${BASH_REMATCH[1]}"
        CRED_PROTO="${REMOTE_URL%%://*}"
    elif [[ "$REMOTE_URL" =~ @([^:]+): ]]; then
        CRED_HOST="${BASH_REMATCH[1]}"
        CRED_PROTO="https"  # SSH 也用 https credential（Git 会 fallback）
    fi

    if [ -n "${CRED_HOST:-}" ]; then
        mkdir -p "$HOME"
        # 避免写入重复行
        if [ -f "$HOME/.git-credentials" ]; then
            grep -v "^${CRED_PROTO}://.*@${CRED_HOST}\$" "$HOME/.git-credentials" > "$HOME/.git-credentials.tmp" 2>/dev/null || true
            mv "$HOME/.git-credentials.tmp" "$HOME/.git-credentials"
        fi
        echo "${CRED_PROTO}://oauth2:${TOKEN}@${CRED_HOST}" >> "$HOME/.git-credentials"
        chmod 600 "$HOME/.git-credentials"
        git config credential.helper store
        echo "   🔑 Token 已写入 ~/.git-credentials （仅本机可见）"
    else
        echo "   ⚠️  无法从 REMOTE_URL 提取主机名，跳过 token 配置"
    fi
elif [ -f "$HOME/.git-credentials" ]; then
    git config credential.helper store
    echo "   🔑 credential.helper = store（已存在）"
fi

echo "   ✅ Git 配置完成"

# ============================================================
# Step 4: 初始同步
# ============================================================
echo ""
echo "🚀 Step 4: 初始同步"

# 先拉取远程以防冲突
git pull origin "$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)" --rebase 2>/dev/null || echo "   ℹ️  无远程内容或拉取失败（首次推送时会自动处理）"

export GIT_SYNC_NAME="$COMMITTER_NAME"
export GIT_SYNC_EMAIL="$COMMITTER_EMAIL"
git-auto-sync "$LOCAL_PATH" || echo "   ⚠️  初始同步跳过（无远程仓库或离线）"

# ============================================================
# Step 5: Cron 定时同步
# ============================================================
echo ""
if [ "$NO_CRON" = false ] && [ "$SYNC_INTERVAL" -gt 0 ]; then
    echo "⏰ Step 5: 注册定时同步（每 ${SYNC_INTERVAL} 分钟）"

    # 生成 cron wrapper 脚本
    CRON_SCRIPT="$HOME/.hermes/scripts/wiki-sync-cron-${WIKI_NAME}.sh"
    mkdir -p "$(dirname "$CRON_SCRIPT")"

    cat > "$CRON_SCRIPT" <<CRON_SCRIPT_EOF
#!/bin/bash
# Auto-generated by wiki-bootstrap — do not edit manually
# Wiki: $WIKI_NAME | Path: $LOCAL_PATH | Interval: ${SYNC_INTERVAL}min
export GIT_SYNC_NAME="$COMMITTER_NAME"
export GIT_SYNC_EMAIL="$COMMITTER_EMAIL"
export PATH="\$HOME/.local/bin:\$PATH"
exec git-auto-sync "$LOCAL_PATH"
CRON_SCRIPT_EOF
    chmod +x "$CRON_SCRIPT"

    # 注册 crontab
    CRON_EXPR="*/${SYNC_INTERVAL} * * * *"
    CRON_LINE="$CRON_EXPR $CRON_SCRIPT"

    # 避免重复注册
    (crontab -l 2>/dev/null | grep -v "$CRON_SCRIPT"; echo "$CRON_LINE") | crontab -

    echo "   📋 Cron 已注册: $CRON_LINE"
    echo "   📄 脚本: $CRON_SCRIPT"
else
    echo "⏰ Step 5: 跳过定时同步（--no-cron 或 sync-interval=0）"
fi

# ============================================================
# 完成摘要
# ============================================================
echo ""
echo "╔════════════════════════════════════════════════════════╗"
echo "║                 ✅ 安装完成！                           ║"
echo "╚════════════════════════════════════════════════════════╝"
echo ""
echo "  📂 知识库路径:   $LOCAL_PATH"
echo "  🌐 远程仓库:     $REMOTE_URL"
echo "  📋 SCHEMA:       $LOCAL_PATH/SCHEMA.md"
echo ""
echo "  命令速查："
echo "    git-auto-sync $LOCAL_PATH        # 手动同步一次"
echo "    wiki-init $LOCAL_PATH \"描述\"    # 重新初始化结构"
echo "    cd $LOCAL_PATH && ls             # 浏览知识库"
echo ""
echo "  同步状态："
if [ "$NO_CRON" = false ] && [ "$SYNC_INTERVAL" -gt 0 ]; then
    echo "    ✅ 自动同步已开启（每 ${SYNC_INTERVAL} 分钟）"
    echo "    📋 crontab -l | grep wiki-sync-cron   # 查看定时任务"
else
    echo "    ⚠️  自动同步未开启"
    echo "    💡 手动启用: wiki-bootstrap $REMOTE_URL $LOCAL_PATH --sync-interval 10"
fi
echo ""
